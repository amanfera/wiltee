# Shared kernel config fragment, applied on top of tinyconfig by scripts/build-linux64.sh,
# followed by platform/linux64-$PROFILE.config (which sets RISCV_ISA_C and FPU).
# "CONFIG_X=n" is translated to "# CONFIG_X is not set". The build fails if any line
# here (or in the profile fragment) does not survive olddefconfig.
#
# Machine: S-mode only (SBI v1.0 answered by the emulator), Sv39, up to 8 harts started
# through SBI HSM, 16550 UART + SiFive PLIC + virtio-mmio blk/net from the device tree,
# timer through SBI set_timer (no Sstc), misaligned accesses trap and are emulated.
#
# RISCV_ALTERNATIVE cannot be switched off in 6.12 (selected by RISCV unless XIP_KERNEL).
# With every optional extension and erratum below disabled, almost no alternatives remain.
# (Zacas has no Kconfig symbol in 6.12.)
# NONPORTABLE is required: otherwise PORTABLE selects EFI, and EFI selects RISCV_ISA_C.

# -- core --
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_RISCV_SBI=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_HZ_100=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_OF=y
CONFIG_BLK_DEV_INITRD=y
# The embedded initramfs stays uncompressed: no boot-time decompression in the guest.
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MODULES=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_CMDLINE="earlycon console=ttyS0"
CONFIG_CMDLINE_FALLBACK=y

# -- ISA and platform: nothing optional, no vendor code, no EFI/relocation --
CONFIG_NONPORTABLE=y
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_RISCV_ISA_ZBA=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZBC=n
CONFIG_RISCV_ISA_ZAWRS=n
CONFIG_RISCV_ISA_SVNAPOT=n
CONFIG_RISCV_ISA_SVPBMT=n
CONFIG_RISCV_ISA_FALLBACK=y
CONFIG_RISCV_SBI_V01=n
CONFIG_RISCV_BOOT_SPINWAIT=n
CONFIG_ERRATA_SIFIVE=n
CONFIG_ERRATA_THEAD=n
CONFIG_ERRATA_ANDES=n
CONFIG_ARCH_MICROCHIP=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_SIFIVE=n
CONFIG_ARCH_SOPHGO=n
CONFIG_SOC_STARFIVE=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_THEAD=n
CONFIG_ARCH_VIRT=n
CONFIG_ARCH_CANAAN=n
CONFIG_EFI=n
CONFIG_RELOCATABLE=n
CONFIG_COMPAT=n
CONFIG_JUMP_LABEL=n
CONFIG_HOTPLUG_CPU=n
CONFIG_NUMA=n
# Misaligned loads/stores trap to S-mode and are emulated; no boot-time timing probe.
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=y
CONFIG_RISCV_PROBE_UNALIGNED_ACCESS=n

# -- console, interrupts, timer --
CONFIG_TTY=y
CONFIG_VT=n
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_UNIX98_PTYS=y
CONFIG_SIFIVE_PLIC=y
CONFIG_RISCV_TIMER=y

# -- filesystems and block --
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_EXT2_FS=y
CONFIG_EXT4_FS=n
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# -- virtio-mmio, discovered from the device tree --
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=n
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# -- networking: busybox ping uses raw sockets, udhcpc uses packet sockets --
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IPV6=n
